# Copy to .env and fill in. .env is git-ignored: never commit real values.

# --- Local development -------------------------------------------------------
# PostgreSQL from docker compose (published on 5433 to avoid clashing with a native install)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/equipment?schema=public
# Separate database used by the integration tests (rows are deleted on every run)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/equipment_test?schema=public
PORT=3001
# Origin allowed by CORS (the frontend URL); comma-separated for several
WEB_ORIGIN=http://localhost:5173
# Backend URL baked into the frontend build
VITE_API_URL=http://localhost:3001

# --- Login (two accounts, one per role) --------------------------------------
# The API and docker compose refuse to start until these are set. For each password run:
#   AUTH_PASSWORD='the-password' npm --prefix apps/api run auth:hash
# and paste the printed PASSWORD_HASH and AUTH_TOKEN_SECRET here. Never commit real values.
AUTH_TOKEN_SECRET=
AUTH_SUPERVISOR_USERNAME=supervisor
AUTH_SUPERVISOR_PASSWORD_HASH=
AUTH_OPERATOR_USERNAME=operador
AUTH_OPERATOR_PASSWORD_HASH=

# --- Deployment (./deploy.sh) -----------------------------------------------
# Public URLs checked at the end of the deploy
PUBLIC_API_URL=https://your-api.up.railway.app
PUBLIC_WEB_URL=https://your-web.vercel.app
# Railway project id (railway status --json) and service names
RAILWAY_PROJECT_ID=
RAILWAY_API_SERVICE=api
RAILWAY_DB_SERVICE=Postgres
RAILWAY_ENV=production
# Vercel project linked to apps/web
VERCEL_PROJECT_NAME=
