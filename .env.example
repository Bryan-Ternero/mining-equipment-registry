# Copie este archivo a .env y complételo. .env está ignorado por git: nunca suba valores reales.

# --- Desarrollo local ----------------------------------------------------------
# PostgreSQL de docker compose (publicado en el 5433 para no chocar con una instalación local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/equipment?schema=public
# Base separada para las pruebas de integración (sus filas se borran en cada corrida)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/equipment_test?schema=public
PORT=3001
# Origen permitido por CORS (la URL del frontend); separados por comas si son varios
WEB_ORIGIN=http://localhost:5173
# URL del backend que queda embebida en el build del frontend
VITE_API_URL=http://localhost:3001

# --- Login (dos cuentas, una por rol) --------------------------------------------
# La API y docker compose no arrancan hasta completarlas. Para cada contraseña ejecute:
#   AUTH_PASSWORD='la-contraseña' npm --prefix apps/api run auth:hash
# y pegue aquí el PASSWORD_HASH y el AUTH_TOKEN_SECRET que imprime. Nunca suba valores reales.
AUTH_TOKEN_SECRET=
AUTH_SUPERVISOR_USERNAME=supervisor
AUTH_SUPERVISOR_PASSWORD_HASH=
AUTH_OPERATOR_USERNAME=operador
AUTH_OPERATOR_PASSWORD_HASH=

# --- Despliegue (./deploy.sh) --------------------------------------------------
# URLs públicas que el despliegue verifica al final
PUBLIC_API_URL=https://your-api.up.railway.app
PUBLIC_WEB_URL=https://your-web.vercel.app
# ID del proyecto en Railway (railway status --json) y nombres de los servicios
RAILWAY_PROJECT_ID=
RAILWAY_API_SERVICE=api
RAILWAY_DB_SERVICE=Postgres
RAILWAY_ENV=production
# Proyecto de Vercel vinculado a apps/web
VERCEL_PROJECT_NAME=
