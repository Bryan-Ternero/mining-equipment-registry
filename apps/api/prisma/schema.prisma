// Modelo de datos del registro de equipos.
//
// - El intervalo de mantenimiento pertenece al tipo de equipo (tabla de catálogo), no al código.
// - "Requiere mantenimiento" se deriva del horómetro, lastServiceHours y el intervalo:
//   nunca se guarda, así no puede desincronizarse del horómetro ni del historial.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Familia de equipos y su intervalo de mantenimiento. Las filas se insertan mediante una migración.
model EquipmentType {
  code                     String @id // CAMION | EXCAVADORA | PERFORADORA
  name                     String
  maintenanceIntervalHours Int

  equipment Equipment[]

  @@map("equipment_types")
}

model Equipment {
  id       String @id @default(uuid()) @db.Uuid
  code     String @unique
  typeCode String

  /// horas de uso acumuladas
  hourmeter Decimal @default(0) @db.Decimal(10, 1)

  /// lectura del horómetro en el último mantenimiento: el inicio del ciclo actual (0 hasta el primero)
  lastServiceHours Decimal @default(0) @db.Decimal(10, 1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  type         EquipmentType       @relation(fields: [typeCode], references: [code])
  maintenances MaintenanceRecord[]

  @@index([typeCode])
  @@map("equipment")
}

/// Un mantenimiento realizado a un equipo. Registrarlo reinicia el ciclo del equipo.
model MaintenanceRecord {
  id          String   @id @default(uuid()) @db.Uuid
  equipmentId String   @db.Uuid
  /// lectura del horómetro cuando se realizó el mantenimiento
  hourmeter   Decimal  @db.Decimal(10, 1)
  performedAt DateTime @default(now())
  notes       String?
  /// usuario de la sesión que lo registró (null en los registros anteriores al login)
  performedBy String?
  createdAt   DateTime @default(now())

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId, performedAt])
  @@map("maintenance_records")
}
