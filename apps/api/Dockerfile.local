# Contenedor local para la API (docker compose --profile full).
# Se llama Dockerfile.local a propósito: un Dockerfile común cambiaría el build de producción de Railway.

# build conserva las dependencias de desarrollo: el servicio "migrate" de compose ejecuta la CLI de Prisma desde aquí
FROM node:24-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY prisma ./prisma
COPY tsconfig.json tsconfig.build.json ./
COPY src ./src
RUN npm run build

FROM build AS prod-deps
RUN npm prune --omit=dev

FROM node:24-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/prisma ./prisma
COPY package.json ./
USER node
EXPOSE 3001
CMD ["node", "dist/server.js"]
